# ============================================================
# GADGET HUB - Environment Configuration (placeholders only)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# --- Central Backend ---
# Relative URL keeps the API on the same origin as the app (works on any port)
NEXT_PUBLIC_API_URL=/api
DB_FILE=data/db.json

# --- Supabase backend (persistent, recommended for serverless/Vercel) ---
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set (and STORE_BACKEND != "json"),
# the JSON-file DB is replaced by Supabase. Apply supabase/schema.sql in the
# Supabase SQL Editor before deploying. STORE_BACKEND=json forces the file DB.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# STORE_BACKEND=json

# --- AI Bulk Product Image Matching (AI Image Importer) ---
# Any OpenAI-compatible vision API. No OpenAI credits? Use the free Groq tier:
#   1. Sign up at https://console.groq.com (no credit card required)
#   2. Create an API key (starts with gsk_) in the Groq dashboard
#   3. Set AI_PROVIDER=groq and put the gsk_ key in AI_API_KEY
# Models: OpenAI gpt-4o-mini | Groq qwen/qwen3.6-27b (vision + JSON mode)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Providers: openai (default), groq (free tier), openrouter (free models),
# or any custom value with AI_BASE_URL=<https://.../v1>.
AI_PROVIDER=openai
# AI_BASE_URL=https://api.groq.com/openai/v1
# Set AI_MOCK=1 to test the UI/review flow offline with zero API calls.
AI_MOCK=

# --- Multi-Channel Notification Webhooks (leave blank to disable a channel) ---
# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram user IDs allowed to open the admin portal from the bot's Web App (comma-separated numeric IDs)
TELEGRAM_ADMIN_IDS=
TELEGRAM_MANAGER_IDS=
# Secret used to verify that webhook requests originate from Telegram (any random string)
TELEGRAM_WEBHOOK_SECRET=
# Public https origin of the deployed app, e.g. https://your-app.vercel.app (used for Web App links)
NEXT_PUBLIC_APP_URL=

# WhatsApp Business API (Cloud API)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Email via SMTP/SendGrid (SendGrid recommended)
SENDGRID_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# --- Admin bootstrap account (created on first server start) ---
# REQUIRED in production. Change from the documented demo default.
ADMIN_EMAIL=admin@gadgetstore.com
ADMIN_PASSWORD=

# --- School Mini-Store: exactly three authorized managers (emails) ---
MANAGER_EMAILS=manager1@gadgetstore.com,manager2@gadgetstore.com,manager3@gadgetstore.com
MANAGER_PASSWORD=

# --- Demo customer account (local demo only) ---
CUSTOMER_PASSWORD=

# Vercel Cron digest guard (used by /api/bot/digest)
CRON_SECRET=
